# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Budget data source: "static" (demo seeds) | "hackforfacts" (upstream GraphQL/REST)
DATA_SOURCE=static
HACK_FOR_FACTS_BASE_URL=http://localhost:3001
HACK_FOR_FACTS_TIMEOUT_MS=3000
# Fiscal year queried from the upstream dataset (the live data lags the demo seed)
HACK_FOR_FACTS_YEAR=2024

# INS data source: "static" (demo seeds) | "insloader" (transparenta-eu-ins-loader)
DATA_SOURCE_INS=static
INS_LOADER_BASE_URL=http://localhost:3002
INS_LOADER_TIMEOUT_MS=3000

# CORS
CORS_ORIGIN=http://localhost:5173
